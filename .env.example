# Copie este archivo a .env y complete con credenciales reales.
# No versionar el archivo .env.
DB_USER=usuario_falso
DB_PASSWORD=contrasena_falsa
DB_JDBC_URL=jdbc:postgresql://localhost:5432/infoufps

# Secreto para firmar los JWT. Debe tener al menos 32 bytes.
JWT_SECRET=cambie-este-secreto-de-al-menos-32-bytes

# Cuenta administradora inicial (opcional).
INITIAL_ADMIN_EMAIL=admin@ufps.edu.co
INITIAL_ADMIN_PASSWORD=cambie-esta-contrasena
INITIAL_ADMIN_NAME=Administrador
